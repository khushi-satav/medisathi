{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "plugins": ["i18next"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "i18next/no-literal-string": ["warn", {
      "markupOnly": true,
      "ignoreCallees": ["t", "console.log", "console.error", "require", "define"],
      "ignoreAttribute": ["className", "style", "key", "ref", "href", "target", "rel", "id", "name", "type", "variant", "size", "color", "title"]
    }]
  }
}
